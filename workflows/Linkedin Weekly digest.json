    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;\nconst recent = rows.filter(r => new Date(r['Submitted At']).getTime() >= weekAgo);\n\nconst count = s => recent.filter(r => r['Status'] === s).length;\nconst byCategory = {};\nrecent.forEach(r => { byCategory[r['Category']] = (byCategory[r['Category']] || 0) + 1; });\n\nconst top = [...recent]\n  .sort((a, b) => Number(b['Score']) - Number(a['Score']))\n  .slice(0, 3)\n  .map(r => `- ${r['Post URL']} (score ${r['Score']})`)\n  .join('\\n');\n\nconst text =\n`Weekly LinkedIn summary\nPosts submitted: ${recent.length}\nTo review: ${count('To review')} | Posted: ${count('Posted')} | Skipped: ${count('Skipped')}\nBy category: ${JSON.stringify(byCategory)}\n\nTop posts:\n${top || 'None this week'}`;\n\nreturn [{ json: { text } }];"
      },
